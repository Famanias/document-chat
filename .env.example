DATABASE_URL=postgresql://user:password@host/database?sslmode=require
OPENROUTER_API_KEY=your_openrouter_key

# Optional model overrides
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
OPENROUTER_JUDGE_MODEL=openrouter/free

# Optional temporary-guest baseline limits
GUEST_MAX_UPLOAD_BYTES=4194304
GUEST_MAX_MESSAGE_CHARACTERS=12000
GUEST_REQUESTS_PER_MINUTE=60
